@@ -0,0 +1,112 @@
+"""Durable message pins through real REST routes and temporary profile stores."""
+
+from pathlib import Path
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from hermes_state import SessionDB
+
+
+@pytest.fixture
+def store(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr("hermes_state.DEFAULT_DB_PATH", home / "state.db")
+    db = SessionDB(db_path=home / "state.db")
+    db.create_session(session_id="chat", source="desktop")
+    from hermes_cli.web_routers.message_pins import router
+    app = FastAPI()
+    app.include_router(router)
+    with TestClient(app) as client:
+        yield db, client, home
+    db.close()
+
+
+def test_pin_survives_reopen_compaction_and_unpins_current_representative(store):
+    db, client, home = store
+    db.append_messages_batch("chat", [
+        {"role": "user", "content": "question"}, {"role": "assistant", "content": "answer"},
+    ])
+    old_rows = db.get_messages("chat")
+    row_id = old_rows[-1]["id"]
+    path = f"/api/sessions/chat/message-pins/{row_id}"
+    assert client.put(path, json={"pinned": True}).status_code == 200
+    assert client.put(path, json={"pinned": True}).status_code == 200
+    assert client.get("/api/sessions/chat/message-pins").json()["pins"][0]["preview"] == "answer"
+    db.archive_and_compact("chat", old_rows, tail_count=2)
+    pins = client.get("/api/sessions/chat/message-pins").json()["pins"]
+    assert len(pins) == 1
+    assert pins[0]["row_id"] != row_id
+    assert pins[0]["message_uid"] == old_rows[-1]["message_uid"]
+    assert client.put(path, json={"pinned": True}).status_code == 200
+    with SessionDB(db_path=home / "state.db", read_only=True) as reader:
+        assert reader.get_messages("chat")[-1]["content"] == "answer"
+    assert client.put(f"/api/sessions/chat/message-pins/{pins[0]['row_id']}", json={"pinned": False}).status_code == 200
+    assert client.get("/api/sessions/chat/message-pins").json()["pins"] == []
+
+
+def test_pins_are_isolated_from_foreign_sessions_branches_and_hidden_or_rewound_rows(store):
+    db, client, _ = store
+    db.append_messages_batch("chat", [{"role": "user", "content": "keep"}])
+    original = db.get_messages("chat")[0]
+    assert client.put(f"/api/sessions/chat/message-pins/{original['id']}", json={"pinned": True}).status_code == 200
+    db.create_session(session_id="branch", source="desktop", parent_session_id="chat",
+                      model_config={"_branched_from": "chat"})
+    db.append_messages_batch("branch", [original])
+    assert client.get("/api/sessions/branch/message-pins").json()["pins"] == []
+    assert client.put(f"/api/sessions/branch/message-pins/{original['id']}", json={"pinned": True}).status_code == 404
+    db.append_messages_batch("chat", [{"role": "user", "content": "hidden", "display_kind": "hidden"}])
+    hidden = db.get_messages("chat")[-1]
+    assert client.put(f"/api/sessions/chat/message-pins/{hidden['id']}", json={"pinned": True}).status_code == 404
+    db._write_sql("UPDATE messages SET active = 0, compacted = 0 WHERE id = ?", (original["id"],))
+    assert client.get("/api/sessions/chat/message-pins").json()["pins"] == []
+    assert client.put(f"/api/sessions/chat/message-pins/{original['id']}", json={"pinned": True}).status_code == 404
+    assert client.put(f"/api/sessions/chat/message-pins/{original['id']}", json={"pinned": "true"}).status_code == 422
+    assert client.get("/api/sessions/missing/message-pins").status_code == 404
+
+
+def test_compression_lineage_shares_pins_but_profiles_do_not(store):
+    db, client, home = store
+    db.append_messages_batch("chat", [{"role": "assistant", "content": "root reply"}])
+    root = db.get_messages("chat")[0]
+    assert client.put(f"/api/sessions/chat/message-pins/{root['id']}", json={"pinned": True}).status_code == 200
+    db.end_session("chat", "compression")
+    db.create_session(session_id="tip", source="desktop", parent_session_id="chat")
+    db.append_messages_batch("tip", [{"role": "user", "content": "continue"}])
+    assert client.get("/api/sessions/tip/message-pins").json()["pins"][0]["row_id"] == root["id"]
+    work = home / "profiles" / "work"
+    work.mkdir(parents=True)
+    (work / "config.yaml").write_text("model: test\n")
+    with SessionDB(db_path=work / "state.db") as other:
+        other.create_session(session_id="chat", source="desktop")
+        other.append_messages_batch("chat", [{"role": "user", "content": "private work"}])
+    assert client.get("/api/sessions/chat/message-pins?profile=work").json()["pins"] == []
+    assert client.get("/api/sessions/chat/message-pins?profile=missing").status_code == 404
+    db.delete_session("tip", include_compression_chain=True)
+    assert db._read_one("SELECT COUNT(*) FROM message_pins")[0] == 0
+
+
+def test_legacy_rows_pagination_and_authentication(store):
+    db, client, _ = store
+    db.append_messages_batch("chat", [{"role": "user", "content": f"ask {i}"} for i in range(3)])
+    rows = db.get_messages("chat")
+    db._write_sql("UPDATE messages SET message_uid = NULL WHERE id = ?", (rows[0]["id"],))
+    for row in rows:
+        assert client.put(f"/api/sessions/chat/message-pins/{row['id']}", json={"pinned": True}).status_code == 200
+    first = client.get("/api/sessions/chat/message-pins?limit=2").json()
+    second = client.get("/api/sessions/chat/message-pins?limit=2&offset=2").json()
+    assert [p["preview"] for p in first["pins"] + second["pins"]] == ["ask 0", "ask 1", "ask 2"]
+    assert first["pagination"] == {"total": 3, "has_more": True}
+    assert second["pagination"] == {"total": 3, "has_more": False}
+    from hermes_cli.web_server import app, _SESSION_HEADER_NAME, _SESSION_TOKEN
+    with TestClient(app) as authenticated:
+        assert authenticated.get("/api/sessions/chat/message-pins", headers={_SESSION_HEADER_NAME: "wrong"}).status_code == 401
+        assert authenticated.put(f"/api/sessions/chat/message-pins/{rows[0]['id']}", json={"pinned": False},
+                                 headers={_SESSION_HEADER_NAME: "wrong"}).status_code == 401
+        response = authenticated.get("/api/sessions/chat/message-pins", headers={_SESSION_HEADER_NAME: _SESSION_TOKEN})
+        assert response.status_code == 200
+        assert len(response.json()["pins"]) == 3
