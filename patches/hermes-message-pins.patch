diff --git a/hermes_state_message_pins.py b/hermes_state_message_pins.py
new file mode 100644
index 00000000000..f14562cc751
--- /dev/null
+++ b/hermes_state_message_pins.py
@@ -0,0 +1,87 @@
+"""Conversation bookmarks keyed by logical message identity, separate from model context."""
+
+import time
+
+from agent.compaction_display import project_compaction_message_for_display
+from agent.message_metadata import mint_uid
+from hermes_state_common import _placeholders
+from hermes_state_timeline import _display_rows_sql, _register_functions, _snapshot
+
+
+def set_message_pin(db, session_id, row_id, pinned):
+    lineage = db._resume_lineage_ids(session_id)
+
+    def write(conn):
+        row = conn.execute(
+            f"SELECT * FROM messages WHERE id = ? AND session_id IN ({_placeholders(lineage)})",
+            (row_id, *lineage),
+        ).fetchone()
+        if row is None:
+            return False
+        _register_functions(db, conn)
+        uid = row["message_uid"]
+        if uid is None:
+            # Legacy backfill is bounded per open; an explicit pin can reach an older row first.
+            uid = mint_uid()
+            conn.execute("UPDATE messages SET message_uid = ? WHERE session_id = ? AND "
+                         "(id = ? OR (display_order IS NOT NULL AND display_order = ?)) AND message_uid IS NULL",
+                         (uid, row["session_id"], row_id, row["display_order"]))
+        if pinned:
+            sql = _display_rows_sql(conn, row["session_id"]) + """
+                SELECT m.* FROM display_rows d JOIN messages m ON m.id = d.row_id
+                WHERE m.message_uid = :uid LIMIT 1
+            """
+            row = conn.execute(sql, {"sid": row["session_id"], "uid": uid}).fetchone()
+            if row is None:
+                return False
+            message = project_compaction_message_for_display(
+                db._row_to_message_dict(row, warn_context="message pin", summary_flag=True))
+            if (not (row["active"] or row["compacted"]) or message is None
+                    or message["role"] not in {"user", "assistant"}
+                    or message.get("display_kind") == "hidden"):
+                return False
+            conn.execute(
+                "INSERT INTO message_pins(session_id, message_uid, pinned_at) VALUES (?, ?, ?) "
+                "ON CONFLICT(session_id, message_uid) DO NOTHING",
+                (lineage[0], uid, time.time()),
+            )
+        else:
+            conn.execute("DELETE FROM message_pins WHERE session_id = ? AND message_uid = ?",
+                         (lineage[0], uid))
+        return True
+
+    return db._execute_write(write)
+
+
+def get_message_pins(db, session_id, *, limit=500, offset=0):
+    lineage = db._resume_lineage_ids(session_id)
+    candidates = {}
+    entries = []
+    with _snapshot(db) as conn:
+        _register_functions(db, conn)
+        for segment in lineage:
+            sql = _display_rows_sql(conn, segment) + """
+                SELECT m.id, m.message_uid FROM display_rows d JOIN messages m ON m.id = d.row_id
+                JOIN message_pins p ON p.message_uid = m.message_uid AND p.session_id = :owner
+                WHERE m.role IN ('user', 'assistant') AND COALESCE(m.display_kind, '') <> 'hidden'
+                ORDER BY d.sort_id
+            """
+            rows = conn.execute(sql, {"sid": segment, "owner": lineage[0]}).fetchall()
+            for row in rows:
+                candidates[row["message_uid"]] = row["id"]
+        # Only the selected page hydrates bodies; a long pin list never loads the whole transcript.
+        ids = list(candidates.values())[offset:offset + limit]
+        for row_id in ids:
+            row = conn.execute("SELECT * FROM messages WHERE id = ?", (row_id,)).fetchone()
+            message = project_compaction_message_for_display(
+                db._row_to_message_dict(row, warn_context="message pins", summary_flag=True))
+            if message is None:
+                continue
+            content = message.get("display_content", message.get("content"))
+            if isinstance(content, list):
+                content = " ".join(p.get("text", "") for p in content if isinstance(p, dict))
+            text = " ".join(content.split()) if isinstance(content, str) else ""
+            entries.append({"row_id": row["id"], "message_uid": row["message_uid"],
+                            "role": message["role"], "preview": text[:160], "timestamp": row["timestamp"]})
+    return {"supported": True, "pins": entries,
+            "pagination": {"total": len(candidates), "has_more": offset + limit < len(candidates)}}
diff --git a/hermes_cli/web_routers/message_pins.py b/hermes_cli/web_routers/message_pins.py
new file mode 100644
index 00000000000..153fba70caf
--- /dev/null
+++ b/hermes_cli/web_routers/message_pins.py
@@ -0,0 +1,45 @@
+"""Profile-scoped, authenticated message bookmarks for conversation clients."""
+
+import asyncio
+
+from fastapi import APIRouter, HTTPException, Path, Query
+from pydantic import BaseModel, ConfigDict, StrictBool
+
+from hermes_cli.web_routers.sessions import _serving_profile, _timeline_session_id, _with_db
+from hermes_state_message_pins import get_message_pins, set_message_pin
+
+router = APIRouter()
+
+
+class MessagePinUpdate(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    pinned: StrictBool
+
+
+@router.get("/api/sessions/{session_id}/message-pins")
+async def list_message_pins(session_id: str, profile: str | None = None,
+                            limit: int = Query(500, ge=1, le=500), offset: int = Query(0, ge=0)):
+    owner = _serving_profile(profile)
+
+    def read(db):
+        sid = _timeline_session_id(db, session_id, owner)
+        return {"session_id": sid, "requested_session_id": session_id, "profile": owner,
+                **get_message_pins(db, sid, limit=limit, offset=offset)}
+
+    return await asyncio.to_thread(_with_db, profile, read, read_only=True)
+
+
+@router.put("/api/sessions/{session_id}/message-pins/{row_id}")
+async def update_message_pin(session_id: str, body: MessagePinUpdate,
+                              row_id: int = Path(..., ge=1), profile: str | None = None):
+    owner = _serving_profile(profile)
+
+    def write(db):
+        sid = _timeline_session_id(db, session_id, owner)
+        if not set_message_pin(db, sid, row_id, body.pinned):
+            raise HTTPException(status_code=404, detail="Message not found in this conversation")
+        uid = db._read_one("SELECT message_uid FROM messages WHERE id = ?", (row_id,))[0]
+        return {"session_id": sid, "requested_session_id": session_id, "profile": owner,
+                "row_id": row_id, "message_uid": uid, "pinned": body.pinned}
+
+    return await asyncio.to_thread(_with_db, profile, write, read_only=False)
diff --git a/tests/hermes_cli/test_message_pins.py b/tests/hermes_cli/test_message_pins.py
